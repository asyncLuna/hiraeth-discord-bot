# Discord
DISCORD_BOT_TOKEN=your-discord-bot-token

# MongoDB / Docker Compose
MONGO_DATABASE=zenith
MONGO_USER=zenith
MONGO_PASSWORD=change-this-password

# Local application startup (not required when using Docker Compose)
SPRING_MONGODB_URI=mongodb://zenith:change-this-password@localhost:27017/zenith?authSource=admin
SPRING_PROFILES_ACTIVE=dev

# Optional Sentry configuration
SENTRY_DSN=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_LOGS_ENABLED=false
